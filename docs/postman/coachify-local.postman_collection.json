{
  "info": {
    "name": "Coachify local profile P01\u2013P03 and P07/P08",
    "description": "Development-only fixed identity. Set APP_ENV=development and AUTH_MODE=local_test on the server. No Google credentials or Authorization header needed. Run Read profile before Save background to capture the current version.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "profileVersion",
      "value": "0"
    },
    {
      "key": "institutionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "School categories",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/profile/school-categories"
      }
    },
    {
      "name": "International university search",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/profile/institutions?category=university&country=US&q=harvard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Directory request succeeded\", () => pm.response.to.have.status(200));",
              "const rows = pm.response.json().items;",
              "if (rows.length) pm.collectionVariables.set(\"institutionId\", rows[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"profileVersion\", pm.response.json().version);"
            ]
          }
        }
      ]
    },
    {
      "name": "Save background",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"profileVersion\", pm.response.json().version);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/profile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{profileVersion}},\n  \"occupational_status\": \"student\",\n  \"school_category\": \"university\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Save education (custom institution)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"profileVersion\", pm.response.json().version);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/profile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{profileVersion}},\n  \"education\": {\n    \"institution\": {\n      \"kind\": \"custom\",\n      \"name\": \"Unlisted International College\",\n      \"country_code\": \"SG\"\n    },\n    \"course\": \"Computing & Design (Double Programme)\",\n    \"study_year\": 6\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Save education (catalogue institution)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"profileVersion\", pm.response.json().version);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/profile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{profileVersion}},\n  \"education\": {\n    \"institution\": {\n      \"kind\": \"catalogue\",\n      \"id\": \"{{institutionId}}\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Confirm reviewed education context",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"profileVersion\", pm.response.json().version);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/profile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{profileVersion}},\n  \"confirm_education_context\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update course only",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"profileVersion\", pm.response.json().version);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/profile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{profileVersion}},\n  \"education\": {\n    \"course\": \"Business Analytics & Economics\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update current study year only",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"profileVersion\", pm.response.json().version);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/profile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{profileVersion}},\n  \"education\": {\n    \"study_year\": 5\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
