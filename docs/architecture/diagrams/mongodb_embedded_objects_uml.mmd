classDiagram
direction TB

class CvSkill {
    +String skill_id
    +String name
    +String category
    +String proficiency?
    +Number experience_months?
    +String context?
    +String evidence
    +String original_evidence?
    +String evidence_type
    +Boolean explicit
}

class TargetSkill {
    +String item_id?
    +String skill_id? [null_while_pending]
    +String group_id?
    +String group_operator [all|any]
    +String correction [extracted|user]
    +String name
    +String category
    +String priority
    +String required_proficiency?
    +Number required_experience_months?
    +String context?
    +String evidence?
    +String origin
    +String[] source_urls
}

class InterviewSkill {
    +String skill_id
    +String name
    +String category
    +String interview_stage?
    +String assessment_type?
    +String difficulty?
    +String[] question_patterns
    +Number independent_report_count
    +String[] source_ids
}

class ResearchSource {
    +String source_id
    +String platform
    +String url
    +String title?
    +String evidence?
    +Date reported_date?
    +Date published_date?
    +String role_match?
    +String reliability?
    +String report_group
}

class GapResult {
    +String skill_id
    +String name
    +String gap_type
    +String match_status
    +String importance?
    +String cv_proficiency?
    +String required_proficiency?
    +String explanation
    +String recommendation?
}

class cvs {
    +CvSkill[] skills
}

class career_goals {
    +TargetSkill[] skills
    +NonSkillRequirement[] non_skill_requirements
    +ReviewContent content? [review]
    +ReviewContent baseline? [review]
}

class NonSkillRequirement {
    +String requirement_id
    +String category
    +String description
    +String priority
    +String evidence
    +String origin
    +String correction [extracted|user]
    +String[] source_urls
    +String group_id?
    +String group_operator [all|any]
    +Number minimum_months?
    +Number maximum_months?
    +String completion_status
}

class ReviewContent {
    +String role?
    +String field?
    +String company?
    +String location?
    +String seniority_level?
    +String job_url?
    +String summary?
    +String[] responsibilities
    +TargetSkill[] skills
    +NonSkillRequirement[] non_skill_requirements
}

class interview_research {
    +InterviewSkill[] skills
    +ResearchSource[] sources
}

class skill_gap_analyses {
    +GapResult[] job_skill_gaps
    +GapResult[] interview_prep_gaps
}

cvs *-- CvSkill : embeds
career_goals *-- TargetSkill : embeds
career_goals *-- NonSkillRequirement : embeds
career_goals *-- ReviewContent : draft content and baseline
ReviewContent *-- TargetSkill
ReviewContent *-- NonSkillRequirement
interview_research *-- InterviewSkill : embeds
interview_research *-- ResearchSource : embeds
skill_gap_analyses *-- GapResult : embeds

class Generation {
    +String provider
    +String model
    +String prompt_version
    +String schema_version
    +Date generated_at
}

class InputVersions {
    +ObjectId cv_id
    +Number cv_version
    +String extraction_version
    +Number profile_version
    +ObjectId career_goal_id
    +Number career_goal_version
    +String generation_version
    +ResearchVersion[] research
}

class ResearchVersion {
    +ObjectId id
    +Number version
}

career_goals *-- Generation : provenance
interview_research *-- Generation : provenance
skill_gap_analyses *-- Generation : provenance
skill_gap_analyses *-- InputVersions : pins
InputVersions *-- ResearchVersion : pins

class Answer {
    +String status [answered|partial|skipped]
    +String value?
    +String quote?
}
class Turn {
    +String question
    +Answer answer
    +String reply
}
class RoleSuggestion {
    +String role
    +String field
    +String rationale
    +String uncertainty
}
class CvContext {
    +String mode
    +ObjectId cv_id?
    +String filename?
    +Number version?
    +String extraction_version?
    +Number profile_version?
    +String attachment_sha256?
}
career_goals *-- Answer : draft answers
career_goals *-- Turn : draft turns
career_goals *-- RoleSuggestion : draft suggestions
career_goals *-- CvContext : optional context
