}

class NonSkillRequirement {
    +String requirement_id
    +String category
    +String description
    +String priority [required|preferred|unspecified|conflicting|suggested]
    +String priority_evidence?
    +String priority_origin?
    +String evidence
    +String origin
    +String correction [extracted|user]
    +String[] source_urls
    +String group_id?
    +String group_operator [all|any]
    +Number minimum_months?
    +Number maximum_months?
    +String completion_status
}

class ReviewContent {
    +String employment_type [unknown_if_unstated]
    +String role?
    +String field?
    +String company?
    +String location?
    +String seniority_level?
    +String job_url?
    +String summary?
    +String[] responsibilities
    +TargetSkill[] skills
    +NonSkillRequirement[] non_skill_requirements
}

class interview_research {
    +BraveAnswer[] summaries
