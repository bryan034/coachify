class CvSkill {
    +String skill_id
    +String name
    +String category
    +String proficiency?
    +Number experience_months?
    +String context?
    +String evidence
    +String original_evidence?
    +String evidence_type
    +Boolean explicit
}

class TargetSkill {
    +String item_id?
    +String skill_id? [null_while_pending]
    +String group_id?
    +String group_operator [all|any]
    +String correction [extracted|user]
    +String name
    +String category
    +String priority [required|preferred|unspecified|conflicting|suggested]
    +String priority_evidence?
    +String priority_origin?
    +String required_proficiency?
    +Number required_experience_months?
    +String context?
    +String evidence? [bounded_2400_chars_for_pooled_sources]
    +String origin
    +String[] source_urls
}

class InterviewSkill {
    +String evidence_origin [source_excerpt|brave_summary]
    +String summary_id?
    +String skill_id? [null_while_unmapped]
    +String name
    +String category
    +String interview_stage?
    +String assessment_type?
    +String difficulty?
    +String[] question_patterns
    +Number independent_report_count
    +String[] source_ids
}

class ResearchSource {
    +String source_id
    +String platform
    +String url
    +String title?
    +String evidence?
    +Date reported_date?
    +Date published_date?
    +String role_match?
    +String reliability?
    +String report_group? [verified_origin_only]
    +Date retrieved_at?
}

class GapResult {
    +String skill_id
    +String name
    +String gap_type
    +String match_status
    +String importance?
    +String cv_proficiency?
    +String required_proficiency?
    +String explanation
    +String recommendation?
}

class cvs {
    +CvSkill[] skills
}

class career_goals {
    +TargetSkill[] skills
    +NonSkillRequirement[] non_skill_requirements
