classDiagram
direction TB

class CvSkill {
    +String skill_id
    +String name
    +String category
    +String proficiency?
    +Number experience_months?
    +String context?
    +String evidence
    +String original_evidence?
    +String evidence_type
    +Boolean explicit
}

class TargetSkill {
    +String skill_id
    +String name
    +String category
    +String priority
    +String required_proficiency?
    +Number required_experience_months?
    +String context?
    +String evidence?
    +String origin
    +String[] source_urls
}

class InterviewSkill {
    +String skill_id
    +String name
    +String category
    +String interview_stage?
    +String assessment_type?
    +String difficulty?
    +String[] question_patterns
    +Number independent_report_count
    +String[] source_ids
}

class ResearchSource {
    +String source_id
    +String platform
    +String url
    +String title?
    +String evidence?
    +Date reported_date?
    +Date published_date?
    +String role_match?
    +String reliability?
    +String report_group
}

class GapResult {
    +String skill_id
    +String name
    +String gap_type
    +String match_status
    +String importance?
    +String cv_proficiency?
    +String required_proficiency?
    +String explanation
    +String recommendation?
}

class cvs {
    +CvSkill[] skills
}

class career_goals {
    +TargetSkill[] skills
}

class interview_research {
    +InterviewSkill[] skills
    +ResearchSource[] sources
}

class skill_gap_analyses {
    +GapResult[] job_skill_gaps
    +GapResult[] interview_prep_gaps
}

cvs *-- CvSkill : embeds
career_goals *-- TargetSkill : embeds
interview_research *-- InterviewSkill : embeds
interview_research *-- ResearchSource : embeds
skill_gap_analyses *-- GapResult : embeds

class Generation {
    +String provider
    +String model
    +String prompt_version
    +String schema_version
    +Date generated_at
}

class InputVersions {
    +ObjectId cv_id
    +Number cv_version
    +String extraction_version
    +Number profile_version
    +ObjectId career_goal_id
    +Number career_goal_version
    +String generation_version
    +ResearchVersion[] research
}

class ResearchVersion {
    +ObjectId id
    +Number version
}

career_goals *-- Generation : provenance
interview_research *-- Generation : provenance
skill_gap_analyses *-- Generation : provenance
skill_gap_analyses *-- InputVersions : pins
InputVersions *-- ResearchVersion : pins
