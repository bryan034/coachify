classDiagram
direction TB

class users {
    +String id [canonical UUID]
    +String owner [existing auth namespace]
    +String name
    +String email
    +String auth_provider
    +Date created_at
    +Date updated_at
    +CapabilityDeclaration[] capability_declarations
    +Integer declarations_version
}
note for users "Logical users maps to existing physical accounts. Preserve credentials, verification and P-series records. No user migration."

class cvs {
    +String _id [opaque UUID]
    +String user_id [account UUID]
    +String file_name
    +String private_original_reference?
    +String file_type
    +CvSkill[] skills
    +String extraction_status
    +Integer extraction_version
    +Integer version
    +Integer effective_version
    +CvItem[] items
    +Object corrections
    +Clarification[] clarifications
    +Object reconciliation_candidate?
    +Date created_at
    +Date updated_at
}
note for cvs "CV owns evidence and correction overlays. Original storage is private and temporary. Public API exposes no file path."

class cv_selections {
    <<operational>>
    +String _id [account UUID]
    +String selected_cv_id?
    +Integer version
}
note for cv_selections "One selection per owner. Explicit selection only; upload never changes it. Operational metadata does not add a sixth logical domain authority."

class cv_conversations {
    <<operational>>
    +String _id [opaque UUID]
    +String user_id [account UUID]
    +String cv_id?
    +Integer segment
    +Integer revision
    +Object[] messages
    +String previous_conversation_id?
    +Date updated_at
}
note for cv_conversations "Private bounded segments with paginated messages and action receipts. Independent revision; no second capability authority. Nullable CV supports manual-only entry. No automatic history expiry."

