@startuml elo_dockerised_mvp
title elo — current Compose deployment and data ownership
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam ArrowColor #285F91
skinparam nodeBackgroundColor #F4F8FC
skinparam nodeBorderColor #8DA6BC
skinparam componentBackgroundColor white
skinparam databaseBackgroundColor #EFF6FA

actor "User browser" as Browser
cloud "Model APIs\nOpenAI Python SDK; OpenRouter defaults\nIndependent service settings" as Models
cloud "Public research\nOpenRouter native web search\nBrave LLM Context fallback" as Research
cloud "Live employer job boards\nGreenhouse / Lever / Ashby" as Boards
cloud "Google sign-in (optional)\nSMTP email provider" as Identity

node "Docker Compose — elo-profile" {
  node "NGINX gateway\n127.0.0.1:${GATEWAY_PORT:-8080}\nJoins web and backend networks" as Gateway
  package "web network" {
    node "Next.js frontend\nReact / TypeScript\nPage routes and assets" as Web
  }
  package "backend network — service-to-service HTTP" {
    node "Profile\n/api/v1/profile\nAccounts, background and declarations" as Profile
    node "CV\n/api/v1/cv\nEvidence, extraction, review and conversations" as CV
    node "Career\n/api/v1/career\nCanonical goal, discovery and public research" as Career
    node "Assessment\n/api/v1/assessments\nImmutable versioned comparisons" as Assessment
    node "Roadmap\n/api/v1/roadmaps\nAdviser, plans, sessions and progress" as Roadmap
    node "Jobs\n/api/v1/jobs\nLive search and self-reported applications" as Jobs
    node "Socials\n/api/v1/socials\nExpert chats and pilot credits" as Socials
    node "Dashboard\n/api/v1/dashboard\nStateless progress aggregation" as Dashboard
    node "Mailpit\nDevelopment profile only\nUI at 127.0.0.1:${MAILPIT_PORT:-8025}" as Mailpit
  }
  package "database network — internal: true" {
    node "MongoDB 8.2" as Mongo {
      database "elo_profile\nProfile-owned" as ProfileDB
      database "elo_ingestion\nCV-owned" as CVDB
      database "elo_career\nCareer-owned" as CareerDB
      database "elo_assessment\nAssessment-owned" as AssessmentDB
      database "elo_roadmap\nRoadmap-owned" as RoadmapDB
      database "elo_jobs\nJobs-owned application snapshots" as JobsDB
      database "elo_socials\nSocials-owned schedules, wallets and reports" as SocialsDB
    }
    node "One-shot database initialisers\nmongodb-career-init\nmongodb-planning-init\nmongodb-jobs-init\nmongodb-socials-init" as Init
  }
  artifact "profile_data\nPersistent MongoDB files" as Data
  artifact "cv_uploads\nPrivate originals; expiry cleanup\n24-hour default retention" as Uploads
  artifact "model_budget\nShared persistent daily call allowance" as Budget
}

Browser --> Gateway : Pages, assets and /api/v1 requests
Gateway --> Web : Non-API routes
Gateway --> Profile : /api/v1/profile
Gateway --> CV : /api/v1/cv
Gateway --> Career : /api/v1/career
Gateway --> Assessment : /api/v1/assessments
Gateway --> Roadmap : /api/v1/roadmaps
Gateway --> Jobs : /api/v1/jobs
Gateway --> Socials : /api/v1/socials
Gateway --> Dashboard : /api/v1/dashboard

Profile --> ProfileDB
CV --> CVDB
Career --> CareerDB
Assessment --> AssessmentDB
Roadmap --> RoadmapDB
Jobs --> JobsDB
Socials --> SocialsDB
Init --> Mongo : Bootstrap service users / databases
Mongo --> Data
CV --> Uploads
CV --> Budget
Career --> Budget
Assessment --> Budget
Roadmap --> Budget
CV --> Models
Career --> Models
Assessment --> Models
Roadmap --> Models
Career --> Research
Jobs --> Boards
Profile --> Identity
Profile ..> Mailpit : Dev SMTP

legend bottom
  Source: compose.yaml, gateway/nginx.conf and service implementations.
  Service HTTP dependencies: service-api-dependencies.mmd.
  Home calls domain APIs; it does not use the Dashboard aggregation API.
  Each data owner has a separate database and credentials; foreign reads use HTTP.
  Dashboard has no database. MongoDB Atlas remains a production proposal.
  Profile bootstrap uses MongoDB's init-profile.js mount.
  CV persists parsed extraction state in cv_extraction_states for restart recovery.
  Roadmap outline/week state is nested in workspaces.planner.
  Gateway rejects /internal/ and unknown /api/ paths.
  Review is a scaffold: no ASGI app, Compose service or gateway route.
  Jobs builds external search links for the browser; the server does not fetch those sites.
  Public listings remain transient; saved application snapshots are private.
  The four AI services share model_budget but keep independent provider settings.
  Synthetic tests do not establish live-model quality or deployed readiness.
  Collection / embedded schemas: sibling mongodb_*.mmd files.
  Historical PostgreSQL reference: reference/dockerised-mvp.puml (unchanged).
endlegend
@enduml
