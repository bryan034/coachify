# Public values are included in browser code; never put secrets here.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only URL for future Next.js server-side calls to the gateway.
INTERNAL_API_BASE_URL=http://gateway:80/api/v1

# Google sign-in is not implemented; configuration depends on the chosen integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
