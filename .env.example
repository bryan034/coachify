# Structure-only reference; no credentials are configured.
# Each service will receive its own environment file and database credentials.
COMPOSE_PROJECT_NAME=coachify
GATEWAY_PORT=8080
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://gateway:80/api/v1
DEFAULT_TIMEZONE=Asia/Singapore
CV_UPLOAD_DIR=/app/uploads

# Local development MongoDB credentials: choose these before use.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Provider-specific OAuth and LLM configuration remains undecided.
