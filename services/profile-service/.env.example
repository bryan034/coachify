# Explicit opt-in for local Postman testing; omit/change to google outside development.
APP_ENV=development
AUTH_MODE=local_test
LOCAL_TEST_USER_ID=coachify-local-user
MONGODB_URI=mongodb://coachify_profile:REPLACE_PASSWORD@localhost:27017/coachify_profile
MONGODB_DATABASE=coachify_profile
GOOGLE_CLIENT_ID=
# Optional only for refreshing the public school snapshot; not used at runtime.
DATA_GOV_SG_API_KEY=
