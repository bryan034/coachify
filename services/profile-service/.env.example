# Only for running this service directly; Docker uses infrastructure/docker/.env.
APP_ENV=development
AUTH_MODE=email
MONGODB_URI=mongodb://coachify_profile:REPLACE_PASSWORD@localhost:27017/coachify_profile
MONGODB_DATABASE=coachify_profile

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
# Gmail App Password, not your normal Gmail password.
SMTP_PASSWORD=
# Generate once with: openssl rand -hex 32
OTP_HASH_SECRET=

# Optional for refreshing the public school snapshot; not used at runtime.
DATA_GOV_SG_API_KEY=
