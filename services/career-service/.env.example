# For running Career directly. Docker provides its internal Profile URL.
PROFILE_SERVICE_URL=http://localhost:8080

# Optional AI foundation. Existing previews work with AI_ENABLED=false.
AI_ENABLED=false
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=
AI_API_KEY=
# Match your chosen model's capabilities; see ANALYSIS_CONTRACTS.md.
AI_RESPONSE_MODE=json_object
AI_TOKEN_PARAMETER=max_completion_tokens

# For direct runs, use service-scoped credentials; Docker supplies these.
MONGODB_URI=
MONGODB_DATABASE=coachify_career
CV_SERVICE_URL=http://localhost:8080
