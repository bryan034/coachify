    "BlackoutRule": {
      "additionalProperties": false,
      "description": "A whole day or a time slot, once or repeating. Weekly uses weekdays; monthly uses start_date's day.\n\nOrdering problems are reported as runway issues so the planner form can explain them.",
      "properties": {
        "frequency": {
          "default": "once",
          "enum": [
            "once",
            "daily",
            "weekly",
            "monthly"
          ],
          "title": "Frequency",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "interval": {
          "default": 1,
          "maximum": 52,
          "minimum": 1,
          "title": "Interval",
          "type": "integer"
        },
        "weekdays": {
          "items": {
            "maximum": 6,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 7,
          "title": "Weekdays",
          "type": "array"
        },
        "start_time": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "end_time": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        }
      },
      "required": [
        "start_date"
      ],
      "title": "BlackoutRule",
      "type": "object"
    },
