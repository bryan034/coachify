          "title": "Schema Version",
          "type": "integer"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "opportunity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opportunity Id"
        },
        "employment_type": {
          "default": "unknown",
          "enum": [
            "internship",
            "full_time",
            "part_time",
            "contract",
            "unknown"
          ],
          "title": "Employment Type",
          "type": "string"
        },
        "job_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Url"
        },
        "categories": {
          "additionalProperties": {
            "$ref": "#/$defs/CategoryResult"
