          "title": "Evidence Origin",
          "type": "string"
        },
        "summary_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Id"
        },
        "source_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source_ids",
        "text"
      ],
      "title": "InterviewEvidence",
      "type": "object"
    },
    "InterviewProcess": {
      "additionalProperties": false,
      "properties": {
        "round_count": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Count"
        },
        "round_count_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterviewEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
