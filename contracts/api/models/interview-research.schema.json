            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 2400,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
