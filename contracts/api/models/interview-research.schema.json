        "round": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Round",
          "type": "integer"
        },
        "useful_sources": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Useful Sources"
