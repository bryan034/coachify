{
  "$defs": {
    "AnswerClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "source_ids"
      ],
      "title": "AnswerClaim",
      "type": "object"
    },
    "BraveAnswer": {
      "additionalProperties": false,
      "properties": {
        "summary_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Summary Id",
          "type": "string"
        },
        "provider": {
          "const": "brave",
          "default": "brave",
          "title": "Provider",
          "type": "string"
        },
        "text": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/AnswerClaim"
          },
          "maxItems": 4,
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "summary_id",
        "text",
        "source_ids"
      ],
      "title": "BraveAnswer",
      "type": "object"
    },
    "CategoryResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "running",
            "completed",
            "partial",
            "failed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 20,
          "title": "Findings",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Missing Fields",
          "type": "array"
        },
        "warnings": {
          "items": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Warnings",
          "type": "array"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "researched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Researched At"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "searches": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Searches",
          "type": "integer"
        },
        "model_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        }
      },
      "title": "CategoryResult",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "pattern": "^f[0-9a-f]{16}$",
          "title": "Finding Id",
          "type": "string"
        },
        "field": {
          "maxLength": 40,
          "title": "Field",
          "type": "string"
        },
        "value": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "insufficient_evidence"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "official",
            "candidate_reported",
            "third_party",
            "inferred"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "quotes": {
          "items": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Quotes",
          "type": "array"
        },
        "scope": {
          "enum": [
            "exact",
            "related_role",
            "related_location",
            "related_employment",
            "general"
          ],
          "title": "Scope",
          "type": "string"
        },
        "conflict_group": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Group"
        },
        "last_verified_at": {
          "format": "date-time",
          "title": "Last Verified At",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "field",
        "value",
        "confidence",
        "evidence_type",
        "source_ids",
        "quotes",
        "scope",
        "last_verified_at"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Generation": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "const": "analysis-v1",
          "default": "analysis-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "generated_at"
      ],
      "title": "Generation",
      "type": "object"
    },
    "InterviewEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_origin": {
          "default": "source_excerpt",
          "enum": [
            "source_excerpt",
            "brave_summary"
