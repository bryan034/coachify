        "stages": {
          "items": {
            "$ref": "#/$defs/InterviewStage"
          },
          "maxItems": 8,
          "title": "Stages",
          "type": "array"
        }
      },
      "title": "InterviewProcess",
      "type": "object"
    },
    "InterviewSkill": {
      "additionalProperties": false,
      "properties": {
        "evidence_origin": {
          "default": "source_excerpt",
          "enum": [
            "source_excerpt",
            "brave_summary"
          ],
          "title": "Evidence Origin",
          "type": "string"
        },
        "summary_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Id"
        },
        "skill_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "interview_stage": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interview Stage"
        },
        "assessment_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Type"
        },
        "difficulty": {
          "default": "unknown",
          "enum": [
            "introductory",
            "intermediate",
            "advanced",
            "unknown"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "question_patterns": {
          "items": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Question Patterns",
          "type": "array"
        },
        "independent_report_count": {
          "maximum": 1200,
          "minimum": 0,
          "title": "Independent Report Count",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "category",
        "independent_report_count",
        "source_ids"
      ],
      "title": "InterviewSkill",
      "type": "object"
    },
    "InterviewStage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "assessment_type": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Type"
        },
        "evidence": {
          "$ref": "#/$defs/InterviewEvidence"
        }
      },
      "required": [
        "name",
        "evidence"
      ],
      "title": "InterviewStage",
      "type": "object"
    },
    "OpportunityReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 2,
          "enum": [
            1,
            2
