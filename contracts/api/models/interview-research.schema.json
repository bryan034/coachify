          },
          "title": "Categories",
          "type": "object"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "researched_at": {
          "format": "date-time",
          "title": "Researched At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "warnings": {
          "items": {
            "maxLength": 600,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Warnings",
          "type": "array"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 2,
          "title": "Models",
          "type": "object"
        }
      },
      "required": [
        "fingerprint",
        "opportunity_id",
        "categories",
        "status",
        "researched_at",
        "expires_at"
      ],
      "title": "OpportunityReport",
      "type": "object"
    },
    "ResearchCoverage": {
      "additionalProperties": false,
