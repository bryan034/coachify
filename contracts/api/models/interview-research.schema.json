          "type": "string"
        },
        "report_group": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Group"
        }
      },
      "required": [
        "source_id",
        "platform",
        "url"
      ],
      "title": "ResearchSource",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
