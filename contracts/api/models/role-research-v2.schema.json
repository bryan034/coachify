      },
      "maxItems": 4,
      "title": "Facts",
      "type": "array"
    },
    "duties": {
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 6,
      "title": "Duties",
      "type": "array"
    },
    "topics": {
      "items": {
        "$ref": "#/$defs/BriefTopic"
      },
      "maxItems": 8,
      "title": "Topics",
      "type": "array"
    },
    "pay": {
      "items": {
        "$ref": "#/$defs/BriefPay"
      },
      "maxItems": 3,
      "title": "Pay",
      "type": "array"
    }
