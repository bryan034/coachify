{
  "$defs": {
    "CvSkill": {
      "additionalProperties": false,
      "properties": {
        "canonical_skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Skill Id"
        },
        "skill_registry_version": {
          "default": "skills-v2",
          "title": "Skill Registry Version",
          "type": "string"
        },
        "skill_id": {
          "maxLength": 4000,
          "pattern": "^(?:skill:.+|[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+)$",
          "title": "Skill Id",
          "type": "string"
        },
        "name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "proficiency": {
          "anyOf": [
            {
              "enum": [
                "beginner",
                "intermediate",
                "advanced",
                "expert"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proficiency"
        },
        "experience_months": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experience Months"
        },
        "context": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "evidence_type": {
          "enum": [
            "cv",
            "user_declaration",
            "explicit",
            "inferred",
            "user_corrected",
            "user_clarified",
            "uncertain",
            "mixed"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "explicit": {
          "title": "Explicit",
          "type": "boolean"
        },
        "original_evidence": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Evidence"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/CvSourceEvidence"
          },
          "title": "Source Evidence",
          "type": "array"
        },
        "reported_proficiency": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Proficiency"
        },
        "item_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 160,
          "title": "Item Ids",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/CvSkillSource"
          },
          "maxItems": 160,
          "title": "Sources",
          "type": "array"
        },
        "conflicting_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Conflicting Fields",
          "type": "array"
        }
      },
      "required": [
        "skill_id",
        "name",
        "category",
        "evidence_type",
        "explicit"
      ],
      "title": "CvSkill",
      "type": "object"
    },
    "CvSkillSource": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "cv",
            "user_declaration",
            "explicit",
            "inferred",
            "user_corrected",
            "user_clarified",
            "uncertain",
            "mixed"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "explicit": {
          "title": "Explicit",
          "type": "boolean"
        },
        "support_uncertain": {
          "title": "Support Uncertain",
          "type": "boolean"
        },
        "attribution": {
          "enum": [
            "personal",
            "team",
            "observed",
            "denied",
            "unknown"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "assistance": {
          "enum": [
            "independent",
            "assisted",
            "supervised",
            "unknown"
          ],
          "title": "Assistance",
          "type": "string"
        },
        "proficiency": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proficiency"
        },
        "experience_months": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experience Months"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CvSourceEvidence"
          },
          "maxItems": 200,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "evidence_type",
        "explicit",
        "support_uncertain",
        "attribution",
        "assistance"
      ],
      "title": "CvSkillSource",
      "type": "object"
    },
    "CvSourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "location": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "id",
        "excerpt",
        "location"
      ],
      "title": "CvSourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "CV API boundary snapshot, not permission to query the CV database.",
  "properties": {
    "_id": {
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "analysis-v1",
      "default": "analysis-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_mapping_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Skill Mapping Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    },
    "file_name": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "File Name",
      "type": "string"
    },
    "file_type": {
      "enum": [
        "pdf",
        "docx",
        "txt"
      ],
      "title": "File Type",
      "type": "string"
    },
    "file_url": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Url"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/CvSkill"
      },
      "title": "Skills",
      "type": "array"
    },
    "extraction_status": {
      "enum": [
        "pending",
        "processing",
        "succeeded",
        "failed"
      ],
      "title": "Extraction Status",
      "type": "string"
    },
    "extraction_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Extraction Version",
      "type": "string"
    },
    "profile_version": {
      "minimum": 1,
      "title": "Profile Version",
      "type": "integer"
    }
  },
  "required": [
    "_id",
    "version",
    "skill_mapping_version",
    "created_at",
    "updated_at",
    "user_id",
    "file_name",
    "file_type",
    "extraction_status",
    "extraction_version",
    "profile_version"
  ],
  "title": "CvSnapshot",
  "type": "object"
}
