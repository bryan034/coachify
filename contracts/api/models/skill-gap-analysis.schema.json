{
  "$defs": {
    "GapResult": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Skill Id",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "gap_type": {
          "enum": [
            "job_skill",
            "interview_preparation"
          ],
          "title": "Gap Type",
          "type": "string"
        },
        "match_status": {
          "enum": [
            "supported",
            "partial",
            "uncertain",
            "confirmed_shortfall"
          ],
          "title": "Match Status",
          "type": "string"
        },
        "importance": {
          "anyOf": [
            {
              "enum": [
                "required",
                "preferred",
                "suggested"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Importance"
        },
        "cv_proficiency": {
          "anyOf": [
            {
              "enum": [
                "beginner",
                "intermediate",
                "advanced",
                "expert"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cv Proficiency"
        },
        "required_proficiency": {
          "anyOf": [
            {
              "enum": [
                "beginner",
                "intermediate",
                "advanced",
                "expert"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Proficiency"
        },
        "explanation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "recommendation": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation"
        }
      },
      "required": [
        "skill_id",
        "name",
        "gap_type",
        "match_status",
        "explanation"
      ],
      "title": "GapResult",
      "type": "object"
    },
    "Generation": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "const": "analysis-v1",
          "default": "analysis-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "generated_at"
      ],
      "title": "Generation",
      "type": "object"
    },
    "InputVersions": {
      "additionalProperties": false,
      "properties": {
        "cv_id": {
          "title": "Cv Id",
          "type": "string"
        },
        "cv_version": {
          "minimum": 1,
          "title": "Cv Version",
          "type": "integer"
        },
        "extraction_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Extraction Version",
          "type": "string"
        },
        "profile_version": {
          "minimum": 1,
          "title": "Profile Version",
          "type": "integer"
        },
        "career_goal_id": {
          "title": "Career Goal Id",
          "type": "string"
        },
        "career_goal_version": {
          "minimum": 1,
          "title": "Career Goal Version",
          "type": "integer"
        },
        "generation_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Generation Version",
          "type": "string"
        },
        "research": {
          "items": {
            "$ref": "#/$defs/ResearchVersion"
          },
          "maxItems": 20,
          "title": "Research",
          "type": "array"
        }
      },
      "required": [
        "cv_id",
        "cv_version",
        "extraction_version",
        "profile_version",
        "career_goal_id",
        "career_goal_version",
        "generation_version"
      ],
      "title": "InputVersions",
      "type": "object"
    },
    "ResearchVersion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ResearchVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "_id": {
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "analysis-v1",
      "default": "analysis-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_mapping_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Skill Mapping Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    },
    "cv_id": {
      "title": "Cv Id",
      "type": "string"
    },
    "career_goal_id": {
      "title": "Career Goal Id",
      "type": "string"
    },
    "research_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Research Ids",
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/InputVersions"
    },
    "job_skill_gaps": {
      "items": {
        "$ref": "#/$defs/GapResult"
      },
      "maxItems": 200,
      "title": "Job Skill Gaps",
      "type": "array"
    },
    "interview_prep_gaps": {
      "items": {
        "$ref": "#/$defs/GapResult"
      },
      "maxItems": 200,
      "title": "Interview Prep Gaps",
      "type": "array"
    },
    "analysis_status": {
      "enum": [
        "succeeded",
        "partial"
      ],
      "title": "Analysis Status",
      "type": "string"
    },
    "analysis_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Analysis Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/Generation"
    }
  },
  "required": [
    "_id",
    "version",
    "skill_mapping_version",
    "created_at",
    "updated_at",
    "user_id",
    "cv_id",
    "career_goal_id",
    "inputs",
    "analysis_status",
    "analysis_version",
    "summary",
    "generation"
  ],
  "title": "SkillGapAnalysis",
  "type": "object"
}
