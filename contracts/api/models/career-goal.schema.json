{
  "$defs": {
    "DiscoveryEvidence": {
      "additionalProperties": false,
      "properties": {
        "research_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Research Id",
          "type": "string"
        },
        "selected_area": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Selected Area",
          "type": "string"
        },
        "related_roles": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Related Roles",
          "type": "array"
        },
        "specificity": {
          "enum": [
            "field",
            "role_area",
            "specialisation"
          ],
          "title": "Specificity",
          "type": "string"
        },
        "listings_analysed": {
          "maximum": 30,
          "minimum": 0,
          "title": "Listings Analysed",
          "type": "integer"
        },
        "employers_analysed": {
          "maximum": 30,
          "minimum": 0,
          "title": "Employers Analysed",
          "type": "integer"
        },
        "coverage": {
          "enum": [
            "good",
            "limited",
            "insufficient"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Source Ids",
          "type": "array"
        },
        "researched_at": {
          "format": "date-time",
          "title": "Researched At",
          "type": "string"
        }
      },
      "required": [
        "research_id",
        "selected_area",
        "related_roles",
        "specificity",
        "listings_analysed",
        "employers_analysed",
        "coverage",
        "source_ids",
        "researched_at"
      ],
      "title": "DiscoveryEvidence",
      "type": "object"
    },
    "Generation": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "const": "analysis-v1",
          "default": "analysis-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "generated_at"
      ],
      "title": "Generation",
      "type": "object"
    },
    "JobDate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "application_deadline",
            "interview",
            "job_start"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        }
      },
      "required": [
        "kind",
        "text",
        "evidence"
      ],
      "title": "JobDate",
      "type": "object"
    },
    "NonSkillRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "qualification",
            "experience",
            "eligibility",
            "location",
            "work_condition",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "priority": {
          "enum": [
            "required",
            "preferred",
            "unspecified",
            "conflicting",
            "suggested"
          ],
          "title": "Priority",
          "type": "string"
        },
        "priority_evidence": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority Evidence"
        },
        "priority_origin": {
          "anyOf": [
            {
              "enum": [
                "employer",
                "generated_guidance",
                "user_declaration",
                "market_research"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority Origin"
        },
        "evidence": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "group_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "group_operator": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Group Operator",
          "type": "string"
        },
        "origin": {
          "default": "employer",
          "enum": [
            "employer",
            "generated_guidance",
            "user_declaration",
            "market_research"
          ],
          "title": "Origin",
          "type": "string"
        },
        "correction": {
          "default": "extracted",
          "enum": [
            "extracted",
            "user"
          ],
          "title": "Correction",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Source Urls",
          "type": "array"
        },
        "minimum_months": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Months"
        },
        "maximum_months": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Months"
        },
        "completion_status": {
          "default": "unspecified",
          "enum": [
            "completed",
            "in_progress",
            "unspecified"
          ],
          "title": "Completion Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "category",
        "description",
        "priority",
        "evidence"
      ],
      "title": "NonSkillRequirement",
      "type": "object"
    },
    "TargetSkill": {
      "additionalProperties": false,
      "properties": {
        "canonical_skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Skill Id"
        },
        "skill_registry_version": {
          "default": "skills-v2",
          "title": "Skill Registry Version",
          "type": "string"
        },
        "skill_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        },
        "item_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "group_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "group_operator": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Group Operator",
          "type": "string"
        },
        "correction": {
          "default": "extracted",
          "enum": [
            "extracted",
            "user"
          ],
          "title": "Correction",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "priority": {
          "enum": [
            "required",
            "preferred",
            "unspecified",
            "conflicting",
            "suggested"
          ],
          "title": "Priority",
          "type": "string"
        },
        "priority_evidence": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority Evidence"
        },
        "priority_origin": {
          "anyOf": [
            {
              "enum": [
                "employer",
                "generated_guidance",
                "user_declaration",
                "market_research"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority Origin"
        },
        "required_proficiency": {
          "anyOf": [
            {
              "enum": [
                "beginner",
                "intermediate",
                "advanced",
                "expert"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Proficiency"
        },
        "required_experience_months": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Experience Months"
        },
        "context": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "evidence": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "origin": {
          "enum": [
            "employer",
            "generated_guidance",
            "user_declaration",
            "market_research"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_urls": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Source Urls",
          "type": "array"
        }
      },
      "required": [
        "name",
        "category",
        "priority",
        "origin"
      ],
      "title": "TargetSkill",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "_id": {
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "analysis-v1",
      "default": "analysis-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "skill_mapping_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Skill Mapping Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "job_dates": {
      "items": {
        "$ref": "#/$defs/JobDate"
      },
      "maxItems": 8,
      "title": "Job Dates",
      "type": "array"
    },
    "discovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoveryEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    },
    "target_type": {
      "enum": [
        "specific_job",
        "career_exploration"
      ],
      "title": "Target Type",
      "type": "string"
    },
    "field": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Field",
      "type": "string"
    },
    "role": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Role",
      "type": "string"
    },
    "employment_type": {
      "default": "unknown",
      "enum": [
        "internship",
        "full_time",
        "part_time",
        "contract",
        "unknown"
      ],
      "title": "Employment Type",
      "type": "string"
    },
    "company": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company"
    },
    "location": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "seniority_level": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seniority Level"
    },
    "job_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Url"
    },
    "interests": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Interests",
      "type": "array"
    },
    "preferences": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Preferences",
      "type": "array"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/TargetSkill"
      },
      "maxItems": 200,
      "title": "Skills",
      "type": "array"
    },
    "non_skill_requirements": {
      "items": {
        "$ref": "#/$defs/NonSkillRequirement"
      },
      "maxItems": 100,
      "title": "Non Skill Requirements",
      "type": "array"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 600,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "responsibilities": {
      "items": {
        "maxLength": 600,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Responsibilities",
      "type": "array"
    },
    "requirements_source": {
      "enum": [
        "pasted_jd",
        "url_jd",
        "document_jd",
        "career_exploration"
      ],
      "title": "Requirements Source",
      "type": "string"
    },
    "generation_version": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Generation Version",
      "type": "string"
    },
    "generation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Generation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "readiness": {
      "default": "ready",
      "enum": [
        "ready",
        "pending"
      ],
      "title": "Readiness",
      "type": "string"
    },
    "exploration_draft_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exploration Draft Id"
    },
    "exploration_draft_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exploration Draft Version"
    },
    "source_review_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Review Id"
    },
    "source_review_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Review Version"
    },
    "requirements_need_review": {
      "default": false,
      "title": "Requirements Need Review",
      "type": "boolean"
    },
    "source_cv_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Cv Id"
    },
    "source_cv_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Cv Version"
    },
    "source_extraction_version": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Extraction Version"
    },
    "source_profile_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Profile Version"
    }
  },
  "required": [
    "_id",
    "version",
    "skill_mapping_version",
    "created_at",
    "updated_at",
    "user_id",
    "target_type",
    "field",
    "role",
    "requirements_source",
    "generation_version"
  ],
  "title": "CareerGoal",
  "type": "object"
}
