        "evidence_excerpt": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence Excerpt",
          "type": "string"
        }
      },
      "required": [
        "changed_fields",
        "evidence_excerpt"
      ],
      "title": "InterpretedDates",
      "type": "object"
    },
