{
  "$defs": {
    "Clarification": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "project",
            "work",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "uncertainty_key": {
          "title": "Uncertainty Key",
          "type": "string"
        },
        "status": {
          "enum": [
            "unanswered",
            "answered",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        },
        "career_target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Career Target Id"
        },
        "career_target_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Career Target Version"
        },
        "career_target_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Career Target Type"
        },
        "extraction_version": {
          "title": "Extraction Version",
          "type": "integer"
        },
        "reconciliation_required": {
          "default": false,
          "title": "Reconciliation Required",
          "type": "boolean"
        },
        "uncertainty": {
          "title": "Uncertainty",
          "type": "string"
        },
        "answer_revision": {
          "default": 0,
          "title": "Answer Revision",
          "type": "integer"
        },
        "answer_sequence": {
          "default": 0,
          "title": "Answer Sequence",
          "type": "integer"
        },
        "interpretation_status": {
          "default": "not_requested",
          "enum": [
            "not_requested",
            "pending",
            "ready",
            "failed"
          ],
          "title": "Interpretation Status",
          "type": "string"
        },
        "interpretation_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation Error"
        },
        "resolution": {
          "default": "unresolved",
          "enum": [
            "unresolved",
            "resolved",
            "partial",
            "unanswerable"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "interpretation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedInterpretation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "followup_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Followup Of"
        },
        "reconciled_from": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconciled From"
        }
      },
      "required": [
        "id",
        "item_id",
        "kind",
        "question",
        "uncertainty_key",
        "status",
        "answer",
        "career_target_id",
        "career_target_version",
        "extraction_version",
        "uncertainty"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "CvItem": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Fingerprint"
        },
        "kind": {
          "enum": [
            "education",
            "experience",
            "project",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "explicit",
            "inferred",
            "user_corrected",
            "user_clarified"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "skill_ids": {
          "items": {
            "type": "string"
          },
          "title": "Skill Ids",
          "type": "array"
        },
        "skill_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skill Names",
          "type": "array"
        },
        "category": {
          "default": "unspecified",
          "title": "Category",
          "type": "string"
        },
        "proficiency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proficiency"
        },
        "experience_months": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Experience Months"
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "ongoing": {
          "default": false,
          "title": "Ongoing",
          "type": "boolean"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "removed": {
          "title": "Removed",
          "type": "boolean"
        },
        "supporting_item_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Item Ids",
          "type": "array"
        },
        "support_uncertain": {
          "default": false,
          "title": "Support Uncertain",
          "type": "boolean"
        },
        "uncertainties": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        },
        "skill_claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillClaim"
          },
          "title": "Skill Claims",
          "type": "array"
        },
        "review_evidence": {
          "items": {
            "$ref": "#/$defs/ReviewFact"
          },
          "maxItems": 240,
          "title": "Review Evidence",
          "type": "array"
        },
        "validation_issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidationIssue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "provenance",
        "evidence",
        "skill_ids",
        "proficiency",
        "experience_months",
        "removed"
      ],
      "title": "CvItem",
      "type": "object"
    },
    "CvSkill": {
      "properties": {
        "canonical_skill_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Skill Id"
        },
        "skill_registry_version": {
          "default": "skills-v2",
          "title": "Skill Registry Version",
          "type": "string"
        },
        "skill_id": {
          "title": "Skill Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "proficiency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proficiency"
        },
        "experience_months": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Experience Months"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "explicit": {
          "title": "Explicit",
          "type": "boolean"
        },
        "item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Item Ids",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SkillSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "conflicting_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conflicting Fields",
          "type": "array"
        }
      },
      "required": [
        "skill_id",
        "name",
        "category",
        "proficiency",
        "experience_months",
        "context",
        "evidence",
        "evidence_type",
        "explicit",
        "item_ids",
        "sources"
      ],
      "title": "CvSkill",
      "type": "object"
    },
    "ErrorInfo": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "failure_stage": {
          "anyOf": [
            {
              "enum": [
                "source_read",
                "document_parse",
                "model_request",
                "model_repair",
                "response_decode",
                "content_decode",
                "extraction_validation",
                "publication"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Stage"
        },
        "failure_category": {
          "anyOf": [
            {
              "enum": [
                "source_unavailable",
                "invalid_document",
                "not_configured",
                "model_admission",
                "provider_http_error",
                "timeout",
                "connection_error",
                "transport_error",
                "response_too_large",
                "invalid_json",
                "invalid_response",
                "incomplete_output",
                "schema_validation",
                "evidence_validation",
                "unexpected_error",
                "history_capacity",
                "source_changed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        },
        "provider_status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Status Code"
        },
        "repair_attempted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Attempted"
        },
        "provider_reason": {
          "anyOf": [
            {
              "enum": [
                "schema_too_complex",
                "schema_rejected",
                "structured_output_unsupported",
                "unsupported_parameter",
                "invalid_request",
                "authentication_failed",
                "permission_denied",
                "not_found",
                "rate_limit_or_quota",
                "provider_unavailable",
                "http_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Reason"
        },
        "provider_parameter": {
          "anyOf": [
            {
              "enum": [
                "response_format",
                "schema",
                "model",
                "reasoning_effort",
                "temperature",
                "max_tokens",
                "messages"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Parameter"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "excerpt": {
          "description": "Source-linked evidence; CV extraction may contain a faithful summary rather than an exact quotation.",
          "title": "Excerpt",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "id",
        "excerpt",
        "location"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExtractionMetadata": {
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "response_mode": {
          "anyOf": [
            {
              "enum": [
                "json_schema",
                "json_object"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Mode"
        },
        "workflow_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Version"
        },
        "repair_attempts": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Attempts"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "schema_version"
      ],
      "title": "ExtractionMetadata",
      "type": "object"
    },
    "InterpretationMetadata": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_version",
        "schema_version"
      ],
      "title": "InterpretationMetadata",
      "type": "object"
    },
    "InterpretedClaim": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "maxLength": 4000,
          "minLength": 7,
          "title": "Skill Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "attribution": {
          "enum": [
            "personal",
            "team",
            "observed",
            "denied",
            "unknown"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "assistance": {
          "default": "unknown",
          "enum": [
            "independent",
            "assisted",
            "supervised",
            "unknown"
          ],
          "title": "Assistance",
          "type": "string"
        },
        "proficiency": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proficiency"
        },
        "experience_months": {
          "anyOf": [
            {
              "maximum": 1200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experience Months"
        },
        "evidence_excerpt": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Excerpt"
        },
        "changed_fields": {
          "items": {
            "enum": [
              "attribution",
              "assistance",
              "proficiency",
              "experience_months"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Changed Fields",
          "type": "array"
        }
      },
      "required": [
        "skill_id",
        "name",
        "attribution",
        "changed_fields"
      ],
      "title": "InterpretedClaim",
      "type": "object"
    },
    "InterpretedDates": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "ongoing": {
          "default": false,
          "title": "Ongoing",
          "type": "boolean"
        },
        "changed_fields": {
          "items": {
            "enum": [
              "start_date",
              "end_date",
              "ongoing"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Changed Fields",
          "type": "array"
        },
        "evidence_excerpt": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence Excerpt",
          "type": "string"
        }
      },
      "required": [
        "changed_fields",
        "evidence_excerpt"
      ],
      "title": "InterpretedDates",
      "type": "object"
    },
    "ProcessingProgress": {
      "properties": {
        "stage": {
          "enum": [
            "queued",
            "source_read",
            "document_parse",
            "model_request",
            "extraction_validation",
            "model_repair",
            "publication",
            "ready"
          ],
          "title": "Stage",
          "type": "string"
        },
        "percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Percent",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "percent",
        "message"
      ],
      "title": "ProcessingProgress",
      "type": "object"
    },
    "ReviewFact": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "role",
            "responsibilities",
            "personal_contribution",
            "assistance",
            "task_scope",
            "complexity",
            "problem_solving",
            "outcome",
            "skill_use",
            "recency",
            "frequency",
            "limitations",
            "replication_confidence",
            "self_rating"
          ],
          "title": "Field",
          "type": "string"
        },
        "skill_name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Name"
        },
        "attribution": {
          "anyOf": [
            {
              "enum": [
                "personal",
                "shared",
                "team",
                "observed",
                "denied",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "status": {
          "enum": [
            "supported",
            "partial",
            "unknown",
            "conflicting",
            "skipped",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 800,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ReviewQuote"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "field",
        "status",
        "evidence"
      ],
      "title": "ReviewFact",
      "type": "object"
    },
    "ReviewProgress": {
      "properties": {
        "reviewed_topics": {
          "minimum": 0,
          "title": "Reviewed Topics",
          "type": "integer"
        },
        "total_topics": {
          "minimum": 0,
          "title": "Total Topics",
          "type": "integer"
        }
      },
      "required": [
        "reviewed_topics",
        "total_topics"
      ],
      "title": "ReviewProgress",
      "type": "object"
    },
    "ReviewQuote": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
