          "type": "integer"
        },
        "extraction_version": {
          "minimum": 1,
          "title": "Extraction Version",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "answer_revision",
        "resolution",
        "summary",
        "metadata",
        "applied_sequence",
        "extraction_version"
      ],
      "title": "SavedInterpretation",
      "type": "object"
    },
