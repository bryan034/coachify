        "remaining_uncertainties": {
          "items": {
            "enum": [
              "personal_contribution",
              "responsibility",
              "proficiency",
              "duration",
              "claim",
              "qualification",
              "date"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Remaining Uncertainties",
          "type": "array"
