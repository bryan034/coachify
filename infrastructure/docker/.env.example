# Local Postman testing: no Google credentials required.
APP_ENV=development
AUTH_MODE=local_test
LOCAL_TEST_USER_ID=coachify-local-user
# For Google mode, set AUTH_MODE=google and supply the public Web Client ID.
# Google OAuth Web Client ID (public identifier, not a client secret).
GOOGLE_CLIENT_ID=
# Use different random hex strings (e.g. openssl rand -hex 24).
MONGO_ROOT_PASSWORD=
PROFILE_DB_PASSWORD=
