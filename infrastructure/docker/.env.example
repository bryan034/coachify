# Active Docker stack: email/password accounts, Gmail OTP delivery and Gemini career AI.
# Fill in the blank secrets before starting. Never commit your private .env.
APP_ENV=development
AUTH_MODE=email

# Gmail sender and App Password (without spaces); recipients can use any email provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Generate once: openssl rand -hex 32. Preserve it across restarts.
OTP_HASH_SECRET=

# Generate each separately: openssl rand -hex 24.
# Preserve existing values when reusing a MongoDB volume.
MONGO_ROOT_PASSWORD=
PROFILE_DB_PASSWORD=
CAREER_DB_PASSWORD=
CV_DB_PASSWORD=

# One server-only Gemini configuration for all extraction, chat and research reasoning.
# Set AI_ENABLED=false for previews/accounts without model access.
AI_ENABLED=true
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Public research uses LLM Context exclusively; no search-mode setting is needed.
BRAVE_API_KEY=
