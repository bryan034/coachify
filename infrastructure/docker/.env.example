# elo's active Docker stack: local configuration for all implemented services.
# Copy to your ignored infrastructure/docker/.env, then fill the blank secrets.
# Never commit real keys. Preserve existing database passwords when reusing volumes.
# Compose passes only the settings each service needs; a service .env is not required.

# Stack / public gateway. The development override forces Profile APP_ENV=development.
APP_ENV=development
GATEWAY_PORT=8080

# Profile authentication. AUTH_MODE: email, google, or development-only local_test.
# GOOGLE_CLIENT_ID is public (also used in the frontend build), not a client secret.
AUTH_MODE=email
GOOGLE_CLIENT_ID=
# Generate once: openssl rand -hex 32. Preserve across restarts.
OTP_HASH_SECRET=

# Profile email/OTP delivery. Gmail requires an App Password, not your login password.
# SMTP_SECURITY: starttls, ssl, or development-only plain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=no-reply@example.test
# For Gmail set BOTH SMTP_FROM and SMTP_USERNAME to your full Gmail address.
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional development Mailpit UI port; enable its Compose development profile.
# For capture: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=plain,
# SMTP_FROM=no-reply@elo.test, and leave SMTP_USERNAME/SMTP_PASSWORD blank.
MAILPIT_PORT=8025

# MongoDB: generate EACH password separately with openssl rand -hex 24.
MONGO_ROOT_PASSWORD=
PROFILE_DB_PASSWORD=
CAREER_DB_PASSWORD=
CV_DB_PASSWORD=
ASSESSMENT_DB_PASSWORD=
ROADMAP_DB_PASSWORD=

# Career LLM: currently Gemini, shared by Career extraction/chat/reasoning stages.
# Set AI_ENABLED=false to use accounts/previews/saved reads without Career AI.
# This key is independent of CV_LLM_API_KEY below. Keep both server-only.
AI_ENABLED=true
CAREER_LLM_API_KEY=
CAREER_LLM_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=45
AI_RETRIES=1
AI_MAX_OUTPUT_TOKENS=4096
AI_CONTEXT_TOKENS=65536
# Discovery extraction has its own fixed output ceiling; this shared cap does not override it.

# Career public research: currently Brave LLM Context. No search-mode switch is needed.
CAREER_RESEARCH_API_KEY=
# Deprecated GEMINI_API_KEY / BRAVE_API_KEY aliases work only if the respective
# CAREER_* key is absent. An explicitly blank CAREER_* key disables that credential.

# Career Discovery research coverage and evidence freshness.
DISCOVERY_TARGET_LISTINGS=10
DISCOVERY_MAX_LISTINGS=20
DISCOVERY_TARGET_EMPLOYERS=5
DISCOVERY_MAX_FOLLOWUPS=2
DISCOVERY_FRESHNESS_HOURS=168
# Retrieval budgets (5 URLs / 16,384 tokens per query) are fixed in Career code,
# not environment inputs. Do not add unused token/URL settings here.

# Career Opportunity Intelligence. Every reasoning stage uses the Career LLM above.
OPPORTUNITY_ENABLED=true
OPPORTUNITY_MAX_SEARCHES=2
OPPORTUNITY_MAX_FOLLOWUPS=1
OPPORTUNITY_CONCURRENCY=3
OPPORTUNITY_TIMEOUT_SECONDS=30
OPPORTUNITY_RETRIES=1
OPPORTUNITY_SCHEMA_REPAIRS=1
OPPORTUNITY_EVIDENCE_TOKENS=8192
OPPORTUNITY_FRESHNESS_HOURS=168
OPPORTUNITY_INCOMPLETE_HOURS=1
OPPORTUNITY_RUN_SECONDS=300

# Assessment: Gemini compares the selected CV and Career goal evidence.
# Roadmap: Gemini provides personalised planning advice on the Roadmap page.
# Both keys are server-only. You may explicitly use the same Gemini key for both;
# neither service inherits CAREER_LLM_API_KEY. Blank keys keep saved reads available
# but disable new model-backed comparisons/advice. Database passwords above are required.
ASSESSMENT_LLM_API_KEY=
ASSESSMENT_LLM_MODEL=gemini-3.5-flash-lite
ROADMAP_LLM_API_KEY=
ROADMAP_LLM_MODEL=gemini-3.5-flash-lite

# CV: independent OpenAI-compatible model configuration; no model is assumed.
# Leave model/key blank to keep model-backed work unavailable until configured.
CV_LLM_BASE_URL=
CV_LLM_MODEL=
CV_LLM_API_KEY=
# HTTP is for synthetic fixtures only; also requires APP_ENV=development.
CV_LLM_ALLOW_HTTP=false
# Keep uploads <= 10 MiB unless the gateway's multipart limit is also adjusted.
CV_MAX_FILE_BYTES=10485760
CV_MAX_SAVED_CVS_PER_OWNER=50
CV_MAX_SAVED_CVS_GLOBAL=10000
CV_MAX_ORIGINAL_BYTES_PER_OWNER=104857600
CV_MAX_ORIGINAL_BYTES_GLOBAL=10737418240
CV_MODEL_CALLS_PER_OWNER_PER_DAY=120
CV_MODEL_CALLS_GLOBAL_PER_DAY=2000
CV_MODEL_CONCURRENT_PER_OWNER=1
CV_MODEL_CONCURRENT_GLOBAL=3

# Fixed service wiring is owned by compose.yaml, rather than shared env names:
# - PROFILE_SERVICE_URL / CAREER_SERVICE_URL / CV_SERVICE_URL / ASSESSMENT_SERVICE_URL use private service DNS.
# - Each MONGODB_URI / MONGODB_DATABASE uses its service account/database above.
# - CV_STORAGE_PATH=/app/uploads matches its writable volume and image permissions.
# NODE_ENV/HMR flags, tokenizer cache and MongoDB compatibility flags are supplied
# by Dockerfiles/Compose. Code-level policy limits are not environment inputs.
# Dashboard and Review remain scaffolds with no active runtime settings here.

# Optional Profile reference-data maintenance (host-side script, not app runtime).
# Docker Compose does not inject this into the Profile application container.
# Export explicitly when running services/profile-service/scripts/refresh_schools.py.
# DATA_GOV_SG_API_KEY=
