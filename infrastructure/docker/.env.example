# Local development: email/password accounts with OTPs sent to real inboxes.
APP_ENV=development
AUTH_MODE=email

# Gmail sends the emails; users may register with any valid email provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# Set both addresses to your Gmail sender account.
SMTP_FROM=
SMTP_USERNAME=
# Google App Password (without spaces), not your normal Gmail password.
SMTP_PASSWORD=

# Generate once with: openssl rand -hex 32
# Keeps pending verification codes valid across backend restarts. Required in production.
OTP_HASH_SECRET=

# Generate each separately with: openssl rand -hex 24
# Preserve existing values when reusing a MongoDB volume.
MONGO_ROOT_PASSWORD=
PROFILE_DB_PASSWORD=
# New service-scoped passwords. Generate separately; preserve existing values.
CAREER_DB_PASSWORD=
CV_DB_PASSWORD=

# Optional Career AI foundation; no calls are made by preview endpoints.
AI_ENABLED=true
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_RESPONSE_MODE=json_object
AI_TOKEN_PARAMETER=max_completion_tokens
AI_TOKENS_PER_MINUTE=8000

BRAVE_API_KEY=your_brave_key
BRAVE_SEARCH_MODE=search

