# elo's active Docker stack: local configuration for all implemented services.
# Copy to your ignored infrastructure/docker/.env, then fill the blank secrets.
# Never commit real keys. Preserve existing database passwords when reusing volumes.
# Compose passes only the settings each service needs; a service .env is not required.
# Existing installation: update the entries below in your .env; do not overwrite
# the whole file or replace existing database passwords/secrets with blank values.
#
# OpenRouter inference: all four model services use this one server-only key.
# Add your key only to your ignored private .env, never this public template.
# OPENROUTER_MODEL accepts a model ID or @preset/<slug> for a preset created in
# OpenRouter. Each service can override its own model or key if required.
# A service uses the shared key only with https://openrouter.ai; its own nonblank
# key takes precedence. Keep public research configured separately below.
# Existing installations must update their private provider, URLs and model values;
# changing this example does not change an existing .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Stack / public gateway. The development override forces Profile APP_ENV=development.
APP_ENV=development
GATEWAY_PORT=8080

# Profile authentication. AUTH_MODE: email, google, or development-only local_test.
# GOOGLE_CLIENT_ID is public (also used in the frontend build), not a client secret.
AUTH_MODE=email
GOOGLE_CLIENT_ID=
# Generate once: openssl rand -hex 32. Preserve across restarts.
OTP_HASH_SECRET=

# Profile email/OTP delivery. Gmail requires an App Password, not your login password.
# SMTP_SECURITY: starttls, ssl, or development-only plain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=no-reply@example.test
# For Gmail set BOTH SMTP_FROM and SMTP_USERNAME to your full Gmail address.
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional development Mailpit UI port; enable its Compose development profile.
# For capture: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=plain,
# SMTP_FROM=no-reply@elo.test, and leave SMTP_USERNAME/SMTP_PASSWORD blank.
MAILPIT_PORT=8025

# MongoDB: generate EACH password separately with openssl rand -hex 24.
MONGO_ROOT_PASSWORD=
PROFILE_DB_PASSWORD=
CAREER_DB_PASSWORD=
CV_DB_PASSWORD=
ASSESSMENT_DB_PASSWORD=
ROADMAP_DB_PASSWORD=
JOBS_DB_PASSWORD=

# Career LLM: one OpenAI-compatible model for extraction/chat/research reasoning.
# Set AI_ENABLED=false to use accounts/previews/saved reads without Career AI.
# With AI_ENABLED=true, Career requires a key at startup.
# Leave the service-specific key blank to use the shared OpenRouter key.
AI_ENABLED=true
CAREER_LLM_API_KEY=
CAREER_LLM_PROVIDER=compatible
# Career uses the OpenRouter OpenAI-compatible API base.
CAREER_LLM_BASE_URL=https://openrouter.ai/api/v1
CAREER_LLM_MODEL=${OPENROUTER_MODEL}
# Strict schema decoding is required for Career Discovery with this provider.
CAREER_LLM_RESPONSE_MODE=json_schema_strict
# Set max_completion_tokens for models requiring that OpenAI SDK parameter.
CAREER_LLM_TOKEN_PARAMETER=max_tokens
AI_TIMEOUT_SECONDS=60
# Local provider only: per-call inference budget after waiting for its single slot.
# Default 60 seconds, range 1-300; cloud uses AI_TIMEOUT_SECONDS (maximum 60).
CAREER_LOCAL_TIMEOUT_SECONDS=60
AI_RETRIES=1
# Global completion ceiling. Local JD identification/extraction allow 8192;
# cloud identification and public research planning/structuring allow 4096;
# the full instructions + schema + JD + safety margin must fit AI_CONTEXT_TOKENS.
AI_CONTEXT_TOKENS=32768
AI_MAX_OUTPUT_TOKENS=2048
# Discovery extraction has its own fixed output ceiling; this shared cap does not override it.

# Testing: brave uses GET /res/v1/llm/context with a Brave key.
# Production: deepseek uses POST https://api.deepseek.com/v1/tools/search;
# replace this key with a DeepSeek key (it may be the same cloud key as the LLM).
CAREER_RESEARCH_PROVIDER=brave
CAREER_RESEARCH_API_KEY=
# Direct (non-Compose) processes may use GEMINI_API_KEY / BRAVE_API_KEY only for
# their own provider and when the canonical key is absent. Compose requires the
# canonical keys above so a provider switch cannot forward an old provider's key.

# Career Discovery research coverage and evidence freshness.
DISCOVERY_TARGET_LISTINGS=10
DISCOVERY_MAX_LISTINGS=20
DISCOVERY_TARGET_EMPLOYERS=5
DISCOVERY_MAX_FOLLOWUPS=2
DISCOVERY_FRESHNESS_HOURS=168
# Retrieval budgets (5 URLs / 16,384 tokens per query) are fixed in Career code,
# not environment inputs. Do not add unused token/URL settings here.

# Career Opportunity Intelligence. Every reasoning stage uses the Career LLM above.
OPPORTUNITY_ENABLED=true
OPPORTUNITY_MAX_SEARCHES=2
OPPORTUNITY_MAX_FOLLOWUPS=1
OPPORTUNITY_CONCURRENCY=3
OPPORTUNITY_TIMEOUT_SECONDS=30
OPPORTUNITY_RETRIES=2
OPPORTUNITY_SCHEMA_REPAIRS=1
OPPORTUNITY_EVIDENCE_TOKENS=8192
OPPORTUNITY_FRESHNESS_HOURS=168
OPPORTUNITY_INCOMPLETE_HOURS=1
OPPORTUNITY_RUN_SECONDS=600

# Assessment compares CV and Career goal evidence. Roadmap supports plans and chat.
# Leave service-specific keys blank to use OPENROUTER_API_KEY with OpenRouter.
# Set TOKEN_PARAMETER=max_completion_tokens for models requiring that parameter.
ASSESSMENT_LLM_API_KEY=
ASSESSMENT_LLM_MODEL=${OPENROUTER_MODEL}
# Assessment model endpoint.
ASSESSMENT_LLM_BASE_URL=https://openrouter.ai/api/v1
ASSESSMENT_LLM_TOKEN_PARAMETER=max_tokens
ASSESSMENT_LLM_ALLOW_HTTP=false
ROADMAP_LLM_API_KEY=
ROADMAP_LLM_MODEL=${OPENROUTER_MODEL}
# Roadmap model endpoint.
ROADMAP_LLM_BASE_URL=https://openrouter.ai/api/v1
ROADMAP_LLM_TOKEN_PARAMETER=max_tokens
ROADMAP_LLM_ALLOW_HTTP=false

# Jobs fetches public employer boards on request. No provider API key is needed.

# CV: OpenRouter configuration through the OpenAI SDK.
# Leave its service-specific key blank to use the shared OpenRouter key.
CV_LLM_BASE_URL=https://openrouter.ai/api/v1
CV_LLM_MODEL=${OPENROUTER_MODEL}
# Extraction/repair only: schema-constrained decoding by default. No automatic downgrade.
# json_object explicitly opts out for providers such as DeepSeek Chat Completions.
# Backend validation and one repair remain enforced.
CV_LLM_RESPONSE_MODE=json_schema
CV_LLM_API_KEY=
# HTTP is for synthetic fixtures only; also requires APP_ENV=development.
CV_LLM_ALLOW_HTTP=false
# Keep uploads <= 10 MiB unless the gateway's multipart limit is also adjusted.
CV_MAX_FILE_BYTES=10485760
CV_MAX_SAVED_CVS_PER_OWNER=50
CV_MAX_SAVED_CVS_GLOBAL=10000
CV_MAX_ORIGINAL_BYTES_PER_OWNER=104857600
CV_MAX_ORIGINAL_BYTES_GLOBAL=10737418240
CV_MODEL_CALLS_PER_OWNER_PER_DAY=120
CV_MODEL_CALLS_GLOBAL_PER_DAY=2000
CV_MODEL_CONCURRENT_PER_OWNER=1
CV_MODEL_CONCURRENT_GLOBAL=3
# Maximum unproductive questions for one unchanged CV interview target (1-5).
CV_INTERVIEW_MAX_TARGET_ATTEMPTS=2

# Fixed service wiring is owned by compose.yaml, rather than shared env names:
# - PROFILE_SERVICE_URL / CAREER_SERVICE_URL / CV_SERVICE_URL / ASSESSMENT_SERVICE_URL use private service DNS.
# - Each MONGODB_URI / MONGODB_DATABASE uses its service account/database above.
# - CV_STORAGE_PATH=/app/uploads matches its writable volume and image permissions.
# NODE_ENV/HMR flags, tokenizer cache and MongoDB compatibility flags are supplied
# by Dockerfiles/Compose. Code-level policy limits are not environment inputs.
# Dashboard and Review remain scaffolds with no active runtime settings here.

# Optional Profile reference-data maintenance (host-side script, not app runtime).
# Docker Compose does not inject this into the Profile application container.
# Export explicitly when running services/profile-service/scripts/refresh_schools.py.
# DATA_GOV_SG_API_KEY=
